# =============================================================================
# Shero WhatsApp Ordering Bot - environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Comments are on their own lines, never after a value: python-dotenv keeps
# everything after `=` as the value, so `KEY=   # a note` sets KEY to "# a note"
# rather than leaving it blank.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Only ONE instance may run the scheduler - two would double-send every
# payment reminder. Set false on any additional API replicas.
ENABLE_SCHEDULER=true

# [REQUIRED] Public https root of this service.
PUBLIC_BASE_URL=https://api.example.com

# Short-link domain for the Pay Now button (Stripe URLs are too long for it).
PAY_REDIRECT_BASE_URL=https://pay.example.com

# Production on one server (deploy/docker-compose.prod.yml): the domain Caddy
# serves and gets the HTTPS certificate for. The host part of PUBLIC_BASE_URL.
DOMAIN=

# --- Hosting on Vercel (docs/vercel-hosting.md) ----------------------------
# Vercel sets VERCEL=1 itself. Required there: a random secret Vercel Cron
# sends to /cron/tick and /cron/daily; nobody else can trigger the jobs.
CRON_SECRET=
# Set by Vercel when a Blob store is connected: dish photos go to Vercel Blob.
BLOB_READ_WRITE_TOKEN=
# Folder for dish photos when Blob is not used (default data/media).
MEDIA_DIR=

# --- Database ----------------------------------------------------------------
# [REQUIRED]
DATABASE_URL=postgresql+asyncpg://shero:shero@localhost:5432/shero_bot

# --- Gallabox (WhatsApp) -----------------------------------------------------
# Settings -> API Keys (app.gallabox.com/apikey). Permission scope must NOT be
# "Read only" - the bot sends messages. The secret is shown only once.
# [REQUIRED]
GALLABOX_API_KEY=
# [REQUIRED]
GALLABOX_API_SECRET=

# [REQUIRED] Settings -> WhatsApp Channel -> Channel Id.
# 24 hex characters, e.g. 647062b51e3c77d2741188cb. NOT the phone number.
GALLABOX_CHANNEL_ID=

# Only used to create and list WhatsApp templates. It is the 24-hex id in
# any Gallabox dashboard URL: /accounts/<this>/... Sending does not need it.
GALLABOX_ACCOUNT_ID=

# The business WhatsApp number, digits with country code (e.g. 14438011011).
# After a web order the page offers an "Open WhatsApp" button that opens this
# chat. Leave empty to hide the button.
WHATSAPP_BUSINESS_NUMBER=

GALLABOX_BASE_URL=https://server.gallabox.com/devapi

# [REQUIRED] We generate this (openssl rand -hex 32) and set the same value on
# the Gallabox webhook config, so forged inbound calls can be rejected.
GALLABOX_WEBHOOK_TOKEN=

# --- Ops API -----------------------------------------------------------------
# [REQUIRED] Shared key the outlet dashboard sends as `X-Ops-Key` to mark
# orders Out for Delivery / Delivered. Generate with: openssl rand -hex 32
OPS_API_KEY=

# --- Admin dashboard ---------------------------------------------------------
# [REQUIRED] Signs the admin session cookie. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# [REQUIRED] Encrypts secrets saved through the Settings page. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes previously saved secrets unreadable; they fall back to
# the values in this file.
SETTINGS_ENCRYPTION_KEY=

# Used once, on first boot, to create the first admin login. Remove both after
# the account exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

ADMIN_SESSION_HOURS=12

# --- Meta (Catalogue + Click-to-WhatsApp ads) --------------------------------
META_GRAPH_VERSION=v21.0

# [REQUIRED] Commerce Manager catalogue id.
META_CATALOG_ID=

# [REQUIRED] Long-lived system user token with catalog_management.
META_SYSTEM_USER_TOKEN=

META_CATALOG_CACHE_TTL_SECONDS=900

# --- Zoho CRM ----------------------------------------------------------------
# Self-Client or Server-based app in api-console.zoho.<dc>.
# Scopes: ZohoCRM.modules.ALL, ZohoCRM.settings.ALL, ZohoCRM.users.READ
# [REQUIRED]
ZOHO_CLIENT_ID=
# [REQUIRED]
ZOHO_CLIENT_SECRET=
# [REQUIRED]
ZOHO_REFRESH_TOKEN=

# Must match the domain you log in at, or every call 401s.
# One of: com | in | eu | au | jp | ca
ZOHO_DATA_CENTER=com

# API name of the custom Orders module.
ZOHO_ORDERS_MODULE=Orders
# Its display field, which holds the order number ("Name" unless the module was made by hand with another).
ZOHO_ORDERS_NAME_FIELD=Name
# API name of the custom Order Items module (one record per dish on a paid order).
ZOHO_ORDER_ITEMS_MODULE=Order_Items

# --- Uber Direct (delivery quote) --------------------------------------------
# [REQUIRED]
UBER_CUSTOMER_ID=
# [REQUIRED]
UBER_CLIENT_ID=
# [REQUIRED]
UBER_CLIENT_SECRET=

UBER_SCOPE=eats.deliveries
UBER_AUTH_URL=https://auth.uber.com/oauth/v2/token
UBER_API_BASE_URL=https://api.uber.com
# Book the courier this many hours before the delivery slot starts.
UBER_DISPATCH_HOURS_BEFORE=2

# --- Stripe ------------------------------------------------------------------
# [REQUIRED] sk_test_... then sk_live_...
# Left blank, checkout is mocked: Pay Now opens a test page, nothing is charged.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# [REQUIRED] whsec_... (we create the webhook endpoint)
STRIPE_WEBHOOK_SECRET=

STRIPE_CURRENCY=usd

# Link expiry + slot release (spec step 15). Stripe's minimum is 30.
PAYMENT_LINK_TTL_MINUTES=30

# Unpaid reminder (spec step 15).
PAYMENT_REMINDER_MINUTES=15

# Optional customer messages, both off at the client's request.
# true re-enables the 15-minute unpaid nudge (payment_reminder).
SEND_PAYMENT_REMINDER=false
# true re-enables 'on its way' and 'delivered' (order_out_for_delivery,
# order_delivered). Orders still move through the stages either way.
SEND_DELIVERY_UPDATES=false

# --- Geocoding / distance ----------------------------------------------------
# Optional. Enables ZIP geocoding + road distance. Without it the service falls
# back to OpenStreetMap Nominatim + straight-line (haversine).
GOOGLE_MAPS_API_KEY=

# Optional. Draws Google's map (with satellite view) on the ordering page's
# address form. This key is visible in the page, so in Google Cloud restrict
# it to HTTP referrers (your domain) and to the Maps JavaScript API only.
# Empty: an OpenStreetMap map is drawn instead; addresses still use the key
# above. Never put the server key here.
GOOGLE_MAPS_BROWSER_KEY=

# haversine | google_matrix
DISTANCE_MODE=haversine
GEOCODER_COUNTRY=US

# --- Client backend (nearby outlets / slots) ---------------------------------
# "local"  -> this service owns the data (default)
# "remote" -> proxy to the client's existing API
OUTLET_SOURCE=local
SLOT_SOURCE=local
CLIENT_BACKEND_BASE_URL=
CLIENT_BACKEND_API_KEY=

# --- Business rules ----------------------------------------------------------
# Applied to the dish subtotal. Confirm with the client.
TAX_PERCENT=0

DEFAULT_DELIVERY_RADIUS_KM=10
SLOT_HOLD_MINUTES=30
# Earliest delivery slot offered, in hours after the customer orders.
SLOT_MIN_LEAD_HOURS=24
# The kitchen gets each new order at this hour (kitchen time) on the delivery day.
KITCHEN_ALERT_HOUR=7

# Spec step 19.
FEEDBACK_DELAY_MINUTES=30
